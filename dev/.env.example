# Copy to dev/.env (untracked) and adjust.

# Host port for the dev instance. Avoid 8096 so it does not clash with an existing Jellyfin.
JELLYFIN_DEV_PORT=8097

# linuxserver.io image only.
PUID=1000
PGID=1000
TZ=Etc/UTC

# API key created in the dev instance (Dashboard > API Keys). Used by verify.sh only.
# Never commit a real value.
JELLYFIN_API_KEY=
