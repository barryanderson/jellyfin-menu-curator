<Project>
    <PropertyGroup>
        <!-- The version is set once, in build.yaml. Releases are tagged v<version>. -->
        <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build.yaml')), '(?m)(?&lt;=^version:\s*&quot;?)[0-9]+(\.[0-9]+){0,3}').Value)</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>

    <Target Name="EnsurePluginVersion" BeforeTargets="Build">
        <Error Condition="'$(Version)' == ''" Text="Could not read the plugin version from build.yaml." />
    </Target>
</Project>
